{
  "name": "brighted-lms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BrightEd LMS Backend built with Express, TypeScript, and Prisma.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "smoke:e2e": "tsx scripts/e2e-smoke.ts",
    "lint": "tsc --noEmit",
    "ci:regression": "node scripts/ci-regression.cjs",
    "ci:e2e": "pnpm smoke:e2e"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.20.2",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
